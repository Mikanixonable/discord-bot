# Discordボットのトークン (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# 全メッセージ自動返信の対象チャンネル/スレッドID (カンマ区切り, 複数可)
# 例: 123456789012345678,234567890123456789
AUTO_REPLY_CHANNEL_IDS=

# ローカルLLM (OpenAI互換, Ollama想定) のベースURL
LLM_BASE_URL=http://localhost:11434/v1

# 使用するモデル名 (例: ollama run で使っているモデル名)
LLM_MODEL=llama3.1

# LLM APIキー (Ollamaでは通常不要。任意のダミー値でも可)
LLM_API_KEY=

# SearXNGのベースURL (任意。Web検索プロバイダとして優先使用。例: http://localhost:8080)
SEARXNG_URL=

# Tavily APIキー (任意。SearXNG未設定時のWeb検索プロバイダとして使用)
TAVILY_API_KEY=

# Web検索結果の取得件数 (デフォルト: 4)
WEB_SEARCH_RESULTS=4

# ツール呼び出しの最大ラウンド数 (デフォルト: 3)
MAX_TOOL_ROUNDS=3

# SearXNGとTavilyのどちらも未設定の場合、Web検索機能は無効になります
