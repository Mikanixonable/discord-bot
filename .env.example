# Discordボットのトークン (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=

# 全メッセージ自動返信の対象チャンネル/スレッドID (カンマ区切り, 複数可)
# 例: 123456789012345678,234567890123456789
AUTO_REPLY_CHANNEL_IDS=

# ローカルLLM (OpenAI互換, Ollama想定) のベースURL
LLM_BASE_URL=http://localhost:11434/v1

# 使用するモデル名 (例: ollama run で使っているモデル名)
LLM_MODEL=llama3.1

# LLM APIキー (Ollamaでは通常不要。任意のダミー値でも可)
LLM_API_KEY=

# SearXNGのベースURL (任意。Web検索プロバイダとして優先使用)
# Docker compose利用時: http://searxng:8080  /  ホストでnpm run dev時: http://localhost:8080
SEARXNG_URL=

# Tavily APIキー (任意。SearXNG未設定時のWeb検索プロバイダとして使用)
TAVILY_API_KEY=

# Web検索結果の取得件数 (デフォルト: 4)
WEB_SEARCH_RESULTS=4

# ツール呼び出しの最大ラウンド数 (デフォルト: 3)
MAX_TOOL_ROUNDS=3

# SearXNGとTavilyのどちらも未設定の場合、Web検索機能は無効になります

# メッセージ全文検索用SQLite DBのファイルパス (デフォルト: ./data/messages.db)
# メッセージ検索はローカルインデックスにより常時有効です
MESSAGE_DB_PATH=./data/messages.db

# メッセージ検索結果の取得件数 (デフォルト: 5)
MESSAGE_SEARCH_RESULTS=5

# 起動時に履歴をバックフィルする対象チャンネル/スレッドID (カンマ区切り、複数可)
# 空の場合は AUTO_REPLY_CHANNEL_IDS のチャンネルのみバックフィル対象になります
BACKFILL_CHANNELS=

# 起動時バックフィルで取得するチャンネルごとの最大メッセージ数 (デフォルト: 500)
BACKFILL_MAX=500

# 重層的記憶: 短期記憶(要約)の最大文字数 (デフォルト: 800)
MEMORY_SHORT_MAX_CHARS=800

# 重層的記憶: 長期記憶(圧縮)の最大文字数 (デフォルト: 400)
MEMORY_LONG_MAX_CHARS=400

# 短期記憶を更新するのに必要な新規メッセージ数 (デフォルト: 15)
MEMORY_FOLD_THRESHOLD=15

# 何回短期記憶を更新したら長期記憶を更新するか (デフォルト: 5)
MEMORY_LONG_EVERY=5
